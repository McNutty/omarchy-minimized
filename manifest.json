{
  "schemaVersion": 1,
  "id": "thord.workspaces",
  "name": "Workspaces plus",
  "version": "2.1.0",
  "author": "Martin Gjerde",
  "license": "MIT",
  "description": "Workspace numbers per monitor, the workspace layout, the focused window's state, the workspace's open windows, and per-workspace minimized windows.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Workspaces.qml"
  },
  "barWidget": {
    "displayName": "Workspaces plus",
    "description": "Each monitor's workspaces, its layout and window state, and the windows open on and minimized from it",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "perMonitor": true,
      "showLayout": true,
      "layoutCycleCommand": "",
      "showWindowState": true,
      "showWindows": true,
      "showMinimized": true
    },
    "schema": [
      { "key": "perMonitor", "type": "boolean", "label": "List only this monitor's workspaces" },
      { "key": "showLayout", "type": "boolean", "label": "Show the workspace layout" },
      { "key": "layoutCycleCommand", "type": "string", "label": "Command run with the workspace id when the layout is clicked" },
      { "key": "showWindowState", "type": "boolean", "label": "Show the focused window's state" },
      { "key": "showWindows", "type": "boolean", "label": "Show the workspace's open windows" },
      { "key": "showMinimized", "type": "boolean", "label": "Show minimized windows" }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.workspaces"
  }
}
